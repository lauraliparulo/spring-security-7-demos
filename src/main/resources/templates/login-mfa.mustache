
<!DOCTYPE html>
<html>
<head>
    <title>Welcome</title>
</head>
<body>

<h1>Welcome, {{username}}!</h1>
<p>Your username and password are correct. </p>


<form action="/otp-submit" method="post">
    <label for="otp">Enter OTP from Google Auth:</label>
    <input type="text" name="otp" placeholder="Enter OTP" required />
    <button type="submit">Complete Login</button>
</form>


<br />
<a href="/google-auth-qr">Scan QR Code for Google Authenticator</a>

</body>
</html>
